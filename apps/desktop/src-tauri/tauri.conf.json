{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prompt Waypoint",
  "version": "0.1.0",
  "identifier": "com.caretsix.aiproductmanager",
  "build": {
    "beforeDevCommand": "deno task dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "deno task build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Prompt Waypoint",
        "width": 1280,
        "height": 850,
        "minWidth": 850,
        "minHeight": 600
      },
      {
        "label": "capture",
        "title": "Quick Capture \u2014 Prompt Waypoint",
        "url": "index.html?capture=1",
        "width": 620,
        "height": 760,
        "minWidth": 480,
        "minHeight": 550,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* https: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
