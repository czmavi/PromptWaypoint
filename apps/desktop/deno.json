{
  "tasks": {
    "dev": "vite --host 127.0.0.1",
    "build": "deno check src/main.tsx && vite build",
    "tauri": "tauri",
    "macos:agent": "deno run --allow-read --allow-write --allow-env --allow-run --allow-net scripts/bundle-agent.ts",
    "macos:build": "deno task macos:agent && tauri build --no-sign --target universal-apple-darwin --config src-tauri/tauri.macos.conf.json",
    "macos:release": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run scripts/release-macos.ts"
  },
  "imports": {
    "preact": "npm:preact@10.29.7",
    "preact/hooks": "npm:preact@10.29.7/hooks",
    "preact/jsx-runtime": "npm:preact@10.29.7/jsx-runtime",
    "preact/test-utils": "npm:preact@10.29.7/test-utils"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": [
      "dom",
      "dom.iterable",
      "deno.ns"
    ],
    "strict": true
  },
  "exclude": [
    "dist",
    "src-tauri/target",
    "src-tauri/gen"
  ]
}
