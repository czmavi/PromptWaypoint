# Keep CocoaPods aligned with the canonical Tauri iOS deployment target.
require 'json'
ios_config = JSON.parse(File.read(File.expand_path('../../tauri.ios.conf.json', __dir__)))

target 'mobile_iOS' do
platform :ios, ios_config.fetch('bundle').fetch('iOS').fetch('minimumSystemVersion')
  # Pods for mobile_iOS
end

target 'mobile_macOS' do
platform :osx, '11.0'
  # Pods for mobile_macOS
end

# Delete the deployment target for iOS and macOS, causing it to be inherited from the Podfile
post_install do |installer|
 installer.pods_project.targets.each do |target|
  target.build_configurations.each do |config|
   config.build_settings.delete 'IPHONEOS_DEPLOYMENT_TARGET'
   config.build_settings.delete 'MACOSX_DEPLOYMENT_TARGET'
  end
 end
end
