{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Companion",
  "version": "0.1.0",
  "identifier": "com.martinvich.mobile",
  "build": {
    "beforeDevCommand": "deno task dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "deno task build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Companion",
        "width": 390,
        "height": 844
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "pmai"
          ],
          "host": "tasks",
          "pathPrefix": [
            "/"
          ]
        },
        {
          "scheme": [
            "pmai"
          ],
          "host": "sessions",
          "pathPrefix": [
            "/"
          ]
        }
      ]
    }
  }
}
